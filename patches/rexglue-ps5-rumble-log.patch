diff --git a/src/kernel/xam/xam_input.cpp b/src/kernel/xam/xam_input.cpp
index 57ccbdd..08cf627 100644
--- a/src/kernel/xam/xam_input.cpp
+++ b/src/kernel/xam/xam_input.cpp
@@ -140,7 +140,37 @@ u32 XamInputSetState_entry(u32 user_index, u32 unk, ppc_ptr_t<X_INPUT_VIBRATION>
 
   (void)unk;  // Unused in this implementation
   auto* is = input_system();
-  return is->SetState(actual_user_index, vibration);
+  X_RESULT result = is->SetState(actual_user_index, vibration);
+
+#if REX_PLATFORM_PS5
+  const uint16_t left_motor = uint16_t(vibration->left_motor_speed);
+  const uint16_t right_motor = uint16_t(vibration->right_motor_speed);
+  if ((left_motor || right_motor) && result == X_ERROR_DEVICE_NOT_CONNECTED &&
+      actual_user_index != 0) {
+    // [tna] The DualSense is assigned to guest user 0. A title that asks for
+    // rumble on another slot (or passes a bogus index) still expects the pad
+    // in hand to buzz: retry user 0 rather than dropping the call.
+    X_RESULT fallback = is->SetState(0, vibration);
+    static bool logged_fallback = false;
+    if (!logged_fallback) {
+      logged_fallback = true;
+      REXKRNL_INFO("[XAM] XamInputSetState: user {} has no pad, user 0 -> {:#x}",
+                   uint32_t(actual_user_index), uint32_t(fallback));
+    }
+    if (fallback == X_ERROR_SUCCESS) {
+      result = fallback;
+    }
+  }
+  static bool logged_rumble = false;
+  if (!logged_rumble && (left_motor || right_motor)) {
+    logged_rumble = true;
+    REXKRNL_INFO("[XAM] XamInputSetState: first rumble user {} (actual {}), motors {}/{} -> {:#x}",
+                 uint32_t(user_index), uint32_t(actual_user_index), uint32_t(left_motor),
+                 uint32_t(right_motor), uint32_t(result));
+  }
+#endif
+
+  return result;
 }
 
 // https://msdn.microsoft.com/en-us/library/windows/desktop/microsoft.directx_sdk.reference.xinputgetkeystroke(v=vs.85).aspx
